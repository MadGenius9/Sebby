{
  "name": "sebby",
  "private": true,
  "description": "Sebby cloud coding and 3D workspace, based on Bot HQ",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "npm run dev -w server & npm run dev -w web",
    "build": "npm run build -w web && npm run build -w server",
    "start": "npm run start -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w web",
    "workspace": "npm run build && node scripts/workspace-local.mjs",
    "test:workspace": "node --import tsx --test tests/workspace*.test.mts",
    "test:http": "npm run build && node scripts/smoke-workspace.mjs",
    "test:browser": "npm run build && node tests/workspace-browser.mjs",
    "test:docker": "node --import tsx tests/docker-live.mts",
    "test:github": "node --import tsx tests/github-live.mts",
    "test:docker-dependencies": "node --import tsx tests/docker-dependencies-live.mts"
  },
  "engines": {
    "node": ">=22"
  }
}
