{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sebby trusted-main Windows runner request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "executable",
    "executableSha256",
    "args",
    "workspaceRoot",
    "workingDirectory",
    "timeoutMs",
    "maxOutputBytes"
  ],
  "properties": {
    "version": { "const": 1 },
    "executable": {
      "type": "string",
      "minLength": 3,
      "maxLength": 240,
      "pattern": "^[A-Za-z]:\\\\.*\\.[Ee][Xx][Ee]$"
    },
    "executableSha256": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "args": {
      "type": "array",
      "maxItems": 64,
      "items": { "type": "string", "maxLength": 4096 }
    },
    "workspaceRoot": { "type": "string", "minLength": 4, "maxLength": 240 },
    "workingDirectory": { "type": "string", "minLength": 4, "maxLength": 240 },
    "timeoutMs": { "type": "integer", "minimum": 100, "maximum": 120000 },
    "maxOutputBytes": { "type": "integer", "minimum": 1024, "maximum": 1048576 }
  }
}
